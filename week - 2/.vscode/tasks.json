{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start VisionPort Gateway",
      "type": "shell",
      "command": "python -m uvicorn services.api_gateway.main:app --host 0.0.0.0 --port 8080 --reload",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Run Unit Tests",
      "type": "shell",
      "command": "python -m pytest tests/test_pipeline.py -v",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Run Benchmark Simulation",
      "type": "shell",
      "command": "python scripts/benchmark_triton.py --concurrency 8 --frames 25 --batch-size 1",
      "problemMatcher": []
    }
  ]
}

